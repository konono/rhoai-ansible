{#- chat template の解決。
    custom_chat_template を指定したときだけ role が ConfigMap を作り、
    その名前は chat_template_configmap で上書きできる（既定は <model>-chat-template）。
    chat_template_configmap だけを指定した場合は、利用者が別途作成済みの
    ConfigMap をマウントする。どちらも空ならモデル同梱の chat template を使い、
    --chat-template は付けない。 -#}
{% set _ctcm = (_model_cfg.chat_template_configmap | default('')) if (_model_cfg.chat_template_configmap | default('')) | length > 0
               else ((_model_name ~ '-chat-template') if (_model_cfg.custom_chat_template | default('')) | length > 0 else '') %}
apiVersion: serving.kserve.io/v1alpha2
kind: LLMInferenceService
metadata:
  name: "{{ _model_name }}"
  namespace: "{{ _model_cfg.namespace }}"
  annotations:
    alpha.maas.opendatahub.io/tiers: '[]'
spec:
  model:
    uri: "pvc://hf-model-cache/{{ _model_name }}"
    name: "{{ _model_name }}"
  replicas: {{ _model_cfg.replicas | default(1) }}
  router:
    route: {}
    gateway:
      refs:
        - name: maas-default-gateway
          namespace: openshift-ingress
  template:
{% if _model_cfg.node_selector | default({}) %}
    nodeSelector: {{ _model_cfg.node_selector | to_json }}
{% endif %}
    containers:
      - name: main
        image: {{ _model_cfg.vllm_image }}
        args:
{# --served-model-name と --chat-template は playbook 側の都合で決まるため自動付与。
   それ以外の vLLM 引数は inventory の vllm_args にそのまま書く（vLLM の版差はここで吸収する）。 #}
{# --served-model-name は KServe/llm-d の起動スクリプトが
   --served-model-name "<name>" "publishers/<ns>/models/<name>" として
   既に付与する。ここで足すと duplicate keys 警告になるため付けない。 #}
{% if _ctcm | length > 0 %}
          - --chat-template=/chat-templates/chat_template.jinja
{% endif %}
{# KServe/llm-d が生成する起動スクリプトは
     eval "exec vllm serve ... $@"
   の形で引数を評価する。そのため argv として 1 要素で渡しても、
   bash のブレース展開とクォート除去を受ける。実測:
     --speculative-config={"method":"mtp","num_speculative_tokens":1}
       -> --speculative-config=method:mtp
          --speculative-config=num_speculative_tokens:1
   に分割され "duplicate keys" 警告と JSON パースエラーになる。
   値側をシングルクォートで囲むと eval を 1 回通っても原形を保つ。
   対象は {} , * ? [] を含む値（ブレース展開・glob の対象になる文字）。 #}
{% for arg in _model_cfg.vllm_args | default([]) %}
{%   set _needs_quote = arg is search('[{}(),*?\[\]]') %}
{%   if _needs_quote and '=' in arg %}
{%     set _k = arg.split('=', 1)[0] %}
{%     set _v = arg.split('=', 1)[1] %}
{#     既にクォート済みの値を二重に囲まない。scripts/vllm-args.sh のように
       クラスタから読んだ args をそのまま渡してくる経路があり、再適用すると
       ''{...}'' になって eval 後にまた分割されてしまう。 #}
{%     set _quoted = _v | length > 1 and _v.startswith("'") and _v.endswith("'") %}
{%     set _arg = (_k ~ "=" ~ _v) if _quoted else (_k ~ "='" ~ _v ~ "'") %}
{%   else %}
{%     set _arg = arg %}
{%   endif %}
          - '{{ _arg | replace("'", "''") }}'
{% endfor %}
        env:
          - name: HOME
            value: /tmp
          - name: LOGNAME
            value: vllm
          - name: TORCHINDUCTOR_CACHE_DIR
            value: /tmp/torchinductor_cache
          - name: HF_TOKEN
            valueFrom:
              secretKeyRef:
                name: hf-token
                key: HF_TOKEN
{% for k, v in (_model_cfg.vllm_env | default({})).items() %}
          - name: {{ k }}
            value: "{{ v }}"
{% endfor %}
{# inventory が model_defaults を定義すると role defaults を丸ごと置き換えるため、
   一部のキーだけ書いた場合に未定義になる。replicas や startupProbe と同様に
   既定値を持たせて部分上書きでも動くようにする。
   既定値は roles/llm_serving/defaults/main.yml の model_defaults と同じ値。
   render-manifests/render.py の _TEMPLATE_DEFAULTS とも揃えること。 #}
{% set _res = _model_cfg.resources | default({}) %}
{% set _req = _res.requests | default({}) %}
{% set _lim = _res.limits | default({}) %}
        resources:
          requests:
            cpu: "{{ _req.cpu | default('500m') }}"
            memory: {{ _req.memory | default('4Gi') }}
            "{{ _model_cfg.gpu_resource | default('nvidia.com/gpu') }}": "{{ _model_cfg.gpu_count | default(1) }}"
          limits:
            cpu: "{{ _lim.cpu | default('2') }}"
            memory: {{ _lim.memory | default('8Gi') }}
            "{{ _model_cfg.gpu_resource | default('nvidia.com/gpu') }}": "{{ _model_cfg.gpu_count | default(1) }}"
        startupProbe:
          httpGet:
            path: /health
            port: 8000
            scheme: HTTPS
          failureThreshold: {{ _model_cfg.startup_probe_failure_threshold | default(120) }}
          periodSeconds: {{ _model_cfg.startup_probe_period_seconds | default(10) }}
          timeoutSeconds: 1
{# chat template も shm も無い場合は volumeMounts キー自体を出さない #}
{% if (_ctcm | length > 0)
      or (_model_cfg.shm_size | default('') | string | length > 0) %}
        volumeMounts:
{% endif %}
{% if _ctcm | length > 0 %}
          - name: chat-template
            mountPath: /chat-templates
            readOnly: true
{% endif %}
{% if _model_cfg.shm_size | default('') | string | length > 0 %}
          - name: dshm
            mountPath: /dev/shm
{% endif %}
    tolerations:
      - key: nvidia.com/gpu
        operator: Exists
        effect: NoSchedule
{% if (_ctcm | length > 0)
      or (_model_cfg.shm_size | default('') | string | length > 0) %}
    volumes:
{% endif %}
{% if _ctcm | length > 0 %}
      - name: chat-template
        configMap:
          name: {{ _ctcm }}
          items:
            - key: chat_template.jinja
              path: chat_template.jinja
{% endif %}
{% if _model_cfg.shm_size | default('') | string | length > 0 %}
      - name: dshm
        emptyDir:
          medium: Memory
          sizeLimit: {{ _model_cfg.shm_size }}
{% endif %}
