# ============================================================
# ソリューション固有設定
# 各 Role 内でのみ使用。変更の影響範囲は該当 Role に限定。
# ============================================================

# ---- LVM ----
# LVMS の VolumeGroup に使うデバイスパス。以下の形式が使用可能:
#   - /dev/nvme1n1                              (デバイス名 — 再起動で番号が変わる場合あり)
#   - /dev/disk/by-path/pci-0000:34:00.0-nvme-1 (PCI パス — 再起動でも安定、推奨)
#   - /dev/disk/by-id/nvme-Amazon_EC2_...       (デバイス ID — インスタンス固有)
#
# 確認方法 (ノード上で実行):
#   # デバイス一覧 (サイズ・モデルで用途を判別):
#   oc debug node/<node-name> -- chroot /host lsblk -d -o NAME,SIZE,TYPE,MODEL
#
#   # デバイス名と by-path の対応表 (どの PCI パスがどのディスクか確認):
#   oc debug node/<node-name> -- chroot /host bash -c \
#     'for d in $(lsblk -dn -o NAME | grep nvme); do \
#       BP=$(find /dev/disk/by-path -lname "*/$d" -printf "%f" 2>/dev/null); \
#       printf "%-12s %-8s %-40s %s\n" "/dev/$d" \
#         "$(lsblk -dn -o SIZE /dev/$d)" \
#         "$(lsblk -dn -o MODEL /dev/$d)" \
#         "${BP:-(none)}"; \
#     done'
#
# EC2 Instance Storage は再起動でデバイス番号が変わるため by-path を推奨
lvm_device_paths:
  - /dev/disk/by-path/pci-0000:34:00.0-nvme-1

# ---- MetalLB ----
# 空ならノード IP から自動計算
metallb_ip_range: ""

# ---- GPU 割当について ----
# present なモデルの gpu_count × replicas を GPU リソース名ごとに集計し、容量を超えると
# roles/llm_serving/tasks/main.yml の容量チェックで fail する。
# GPU 1 枚の構成では present にできるモデルは常に 1 つだけ。
#
# モデル A から モデル B へ切り替える手順 (サービス停止を最小化する):
#
#   1. A を動かしたまま B を PVC へ先にダウンロードする。
#      download_only は GPU 容量チェックと absent モデルの削除をスキップするため、
#      両方 present のままで実行できる。
#        uv run ansible-playbook playbooks/llm_download.yml -i inventory/<env>
#
#   2. ダウンロード完了を確認する。
#        oc get job -n llm-serving download-<モデルキー>
#
#   3. 下の models で A を state: absent、B を state: present にする。
#      purge は false のままにすること (PVC 上の A のデータを残し、戻すときの再DLを避ける)。
#
#   4. 入れ替えを実行する。Phase 1 で A の LLMInferenceService が消えて GPU が解放され、
#      Phase 2 で B が起動する。
#        uv run ansible-playbook playbooks/llm_add_model.yml -i inventory/<env>
#
# 注: absent にしたモデルは MaaS の AuthPolicy / Subscription からも外れる。
#     グループ自体は残るが、参照先モデルが無いため Subscription は生成されなくなる。

# ---- LLM Models ----
# vLLM の起動パラメータは roles/llm_serving/vars/model_recipes.yml に
# hf_repo をキーとして持っている（検証済みレシピ）。
# vLLM のパラメータはモデルのアーキテクチャ・量子化方式・ハードウェアで大きく変わり、
# 全モデル共通の既定値では表現できないため、モデルごとのナレッジとして playbook 内に置く。
#
# したがって通常 inventory に書くのは hf_repo と state だけでよい。
# ここで vllm_args を書くとレシピを完全に上書きする。
# パラメータを試すだけなら scripts/vllm-args.sh のほうが速い
# (稼働中の LLMInferenceService の args だけを即時差し替える)。
#
# キーの命名規約: hf_repo のモデル名部分を小文字化し、"." は "-" に置き換える。
#   Qwen/Qwen3.8-27B-FP8 -> qwen3-8-27b-fp8
#   deepseek-ai/DeepSeek-R1-0528 -> deepseek-r1-0528
# k8s リソース名になるため小文字英数と "-" のみ ("." と大文字は不可)。
# キーは PVC 上のディレクトリ名 (/models/<キー>)、vLLM の --served-model-name、
# Keycloak グループ名 (maas-<キー>-users) に変換なしで使われる。一度決めたら変更しないこと
# (改名すると PVC キャッシュがヒットせず再ダウンロードになる)。
# 下記 qwen3-06b は規約制定前の名前のため例外。
llm_storage_initializer_image: quay.io/modh/kserve-storage-initializer:rhoai-2.22
models:
  # 小型モデル。動作確認用。
  qwen3-06b:
    hf_repo: Qwen/Qwen3-0.6B
    state: absent

  # Qwen3.8-27B-FP8
  #   27B / Vision encoder 付き (Qwen3_5ForConditionalGeneration)
  #   fine-grained FP8 (block size 128) / native context 262144 / MTP 学習済み
  #   要件: vLLM 0.17.0+ / transformers >= 5.8.0
  #   パラメータは model_recipes.yml 側 (NVIDIA H200 141GB x1 で検証済み)
  qwen3-8-27b-fp8:
    hf_repo: Qwen/Qwen3.8-27B-FP8
    state: present
    # コンテナ環境変数の追加が必要な場合のみ記述する
    vllm_env:
      VLLM_WORKER_MULTIPROC_METHOD: spawn
      NCCL_DEBUG: WARN

  # レシピ未登録のモデルを足す場合の書き方:
  #   1. まず hf_repo と state だけで起動を試す (_fallback の最小構成が使われる)
  #   2. 動く組み合わせが決まったら model_recipes.yml にエントリを追加する
  # inventory 側で一時的に上書きしたい場合:
  # my-model:
  #   hf_repo: org/My-Model
  #   state: present
  #   vllm_args:                       # 書くとレシピを完全に置き換える
  #     - "--max-model-len=32768"
  #     - "--gpu-memory-utilization=0.90"
  #   gpu_count: 1                     # 1 Pod あたりの GPU / MIG 区画数
  #   gpu_resource: nvidia.com/mig-1g.24gb  # mixed の例。省略時 nvidia.com/gpu
  #   node_selector:                  # 推論 Pod の配置先 (MIG 操作の selector とは別)
  #     mig-group: rtx6000-24gb
  #   resources:
  #     requests: {cpu: "500m", memory: 4Gi}
  #     limits:   {cpu: "2",    memory: 8Gi}
  #   shm_size: ""                     # tensor parallel 時は 16Gi 等 (NCCL 共有メモリ)
  #   custom_chat_template: ""         # 既定は空 = モデル同梱の chat template を使う。
  #                                    # 差し替えたい場合だけ名前を書く。実体は
  #                                    #   inventory/<env>/chat_templates/<名前>.jinja
  #                                    # 例) custom_chat_template: qwen3
  #   chat_template_configmap: ""      # 作成する ConfigMap 名の上書き
  #                                    # (既定: <モデル名>-chat-template)
  #   startup_probe_failure_threshold: 120   # x periodSeconds 秒まで起動を待つ
  #   purge: false                     # state: absent 時に PVC のデータも消すか

# ---- Keycloak ----
keycloak_namespace: keycloak
keycloak_admin_recovery: true  # Existing, Ready Keycloak only; valid credentials cause no changes.
keycloak_realm: maas

# ユーザーは宣言的に管理される。
# 新規ユーザーには 12 文字のパスワードが自動発行され、
# .credentials/<この inventory のディレクトリ名>/<username>.password (0600) に保存される。
# 台帳は inventory ごとに分かれるため、同名ユーザーを別環境で使っても
# パスワードは共有されない。
# 既存ユーザーのパスワードは変更されない (リセットは docs/daily-operations.md 2.3 を参照)。

# 分離前は .credentials/<username>.password のようにフラットに置いていた。
# その台帳を引き継ぐ inventory でだけ true にする (既定 false)。
# 無条件に引き継ぐと同名ユーザーで環境間のパスワード共有が再発するため。
# credentials_adopt_legacy: false
# groups からグループ名を外すと Keycloak 側の所属も解除される
# (解除対象は keycloak_groups に定義済みのグループのみ。
#  止めたい場合は -e keycloak_prune_group_membership=false)。
# groups 自体を書かないユーザーは解除対象外（管理対象外の扱い）。
# 所属を全部外すときは groups: [] と明示する。
keycloak_users:
  - username: admin1
    email: admin1@example.com
    firstName: Admin
    lastName: User
    groups: [maas-admins]
  - username: testuser1
    email: testuser1@example.com
    firstName: Test
    lastName: User
    # グループ名は maas-<モデルキー>-users の命名規則に従う
    groups: [maas-qwen3-8-27b-fp8-users]

# グループを変更すると Keycloak のグループと
# MaaSAuthPolicy / MaaSSubscription の両方が再生成される。
# quota はグループ単位。特定ユーザーだけ増やしたい場合は専用グループを作る。
keycloak_groups:
  maas-admins:
    models: ["*"]              # "*" は present な全モデル
    priority: 20
    quota_tokens_24h: 5000000
    # cluster_role: cluster-admin  # 追加の ClusterRole を付与する場合に指定
    # 注: maas-admins → cluster-admin は maas_resources role が別途適用済み
  # グループ名は maas-<モデルキー>-users に合わせる
  maas-qwen3-8-27b-fp8-users:
    models: ["qwen3-8-27b-fp8"]
    priority: 10
    quota_tokens_24h: 1000000
  # state: absent なモデルを参照するグループは
  # AuthPolicy / Subscription が生成されない (エラーにはならない)
  maas-qwen3-06b-users:
    models: ["qwen3-06b"]
    priority: 10
    quota_tokens_24h: 1000000

# ---- Role 有効/無効 ----
install_lvm: true
install_metallb: true
install_cert_manager: true
install_servicemesh: true
install_nfd: true
install_gpu_operator: true
install_rhcl: true
install_kueue: true
install_jobset: true
install_leaderworkerset: true
install_odf: true
install_rhoai: true
install_keycloak: true
install_llm_serving: true
install_maas_resources: true
install_mlflow: true
install_ogx: true
# NeMo Guardrails は既知の未解決問題があるため既定で無効。
# rail に引っかからない通常の質問が完了せず、vLLM の同時実行枠
# (--max-num-seqs) を占有し続けて本体モデルの応答性能を食い潰す。
# 詳細と確認手順: docs/daily-operations.md「NeMo Guardrails の既知の問題」
# Issue: https://github.com/konono/rhoai-ansible/issues/15
# 有効にする場合は tools/test-guardrails.sh で機能確認すること。
install_guardrails: false
install_observability: true

# ---- Integration 有効/無効 ----
integrate_keycloak_oauth: true
integrate_keycloak_maas: true
integrate_rhoai_oidc: true

