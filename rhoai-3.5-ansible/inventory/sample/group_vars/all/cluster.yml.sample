# ============================================================
# クラスター共通設定
# 複数の Role から参照される。変更は広範囲に影響する。
# ============================================================

# ---- Ansible Root ----
# playbook_dir はエントリポイントにより変わるため、role/playbook 横断で使うパスはこの変数を基準にする
# site.yml (ansible/) → playbook_dir そのまま, playbooks/*.yml → playbook_dir/..
ansible_root: "{{ playbook_dir ~ ('/..' if '/playbooks' in playbook_dir else '') }}"

# ---- Kubeconfig ----
# kubernetes.core モジュールが参照する kubeconfig パス
# 未設定なら KUBECONFIG 環境変数 → ~/.kube/config の順でフォールバック
# k8s_kubeconfig: /path/to/.kube/config

# ---- ストレージ ----
# PVC の StorageClass。lvm, odf, keycloak, rhoai, ogx, mlflow 等が参照
storage_class: lvms-vg1

# ---- Proxy ----
# Proxy 設定は Proxy CR (oc get proxy cluster) の status から自動取得します。
# status.noProxy にはクラスタ内ネットワークの値が OCP によって自動補完されます。
# 参考: https://docs.redhat.com/en/documentation/openshift_container_platform/4.18/html-single/configuring_network_settings/index
# cluster_proxy 変数は廃止 — Proxy CR の status を使用してください。

# ---- Operator チャネル ----
# 全 Operator のバージョンを一元管理
operator_channels:
  lvms_operator: stable-4.22
  metallb_operator: stable
  openshift_cert_manager_operator: stable-v1
  servicemeshoperator3: stable
  nfd: stable
  gpu_operator_certified: stable
  rhcl_operator: stable
  kueue_operator: stable-v1.4
  job_set: stable-v1.0
  leader_worker_set: stable-v1.0
  cluster_observability_operator: stable
  opentelemetry_product: stable
  odf_operator: stable-4.22
  rhods_operator: stable-3.5
  rhbk_operator: stable-v26
  group_sync_operator: alpha

# ---- CatalogSource ----
# オンライン環境ではデフォルトのまま使用
# Disconnected 環境ではミラーカタログの CatalogSource 名に変更する
catalog_sources:
  redhat: redhat-operators
  certified: certified-operators
  community: community-operators

# ---- DB パスワード ----
# 空なら自動生成。rhoai, keycloak, ogx が参照
maas_db_password: ""
ogx_db_password: ""
keycloak_db_password: ""
